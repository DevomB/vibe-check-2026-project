import __LIB__
import Lean

/-! Generated by vibecheck-lean `audit.py`. Safe to delete; it is rewritten on every run. -/

open Lean Elab Command

private def libRoot : Name := `__LIB__

private def inProject (env : Environment) (n : Name) : Bool :=
  match env.getModuleIdxFor? n with
  | some idx => libRoot.isPrefixOf (env.header.moduleNames[idx.toNat]!)
  | none => false

private def axiomsJson (ns : Array Name) : Json :=
  Json.arr (ns.map fun n => Json.str n.toString)

run_cmd do
  let env ← getEnv
  let specRoot := libRoot ++ `Spec
  let mut specs : Array (Name × Expr) := #[]
  let mut thms : Array (Name × Expr) := #[]
  for (n, ci) in env.constants.toList do
    if n.isInternal || !inProject env n then continue
    match ci with
    | .defnInfo d =>
      if specRoot.isPrefixOf n && d.type.isProp then specs := specs.push (n, d.type)
    | .thmInfo t => thms := thms.push (n, t.type.consumeMData)
    | _ => pure ()
  let mut specJs : Array Json := #[]
  for (s, _) in specs.qsort (fun a b => a.1.toString < b.1.toString) do
    let doc ← liftIO <| findDocString? env s
    let mut proofs : Array Json := #[]
    for (t, ty) in thms do
      if ty.isConstOf s then
        let axs ← collectAxioms t
        proofs := proofs.push <| Json.mkObj [("name", t.toString), ("axioms", axiomsJson axs)]
    specJs := specJs.push <| Json.mkObj
      [("name", s.toString), ("doc", doc.getD ""), ("proofs", Json.arr proofs)]
  let mut thmJs : Array Json := #[]
  for (t, _) in thms.qsort (fun a b => a.1.toString < b.1.toString) do
    let axs ← collectAxioms t
    thmJs := thmJs.push <| Json.mkObj [("name", t.toString), ("axioms", axiomsJson axs)]
  let out := Json.mkObj [("specs", Json.arr specJs), ("theorems", Json.arr thmJs)]
  liftIO <| IO.println ("VIBECHECK_AUDIT " ++ out.compress)
